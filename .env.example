# 예시 API의 베이스 URL. 비워 두면 도메인 repository가 번들된 시드로 떨어진다.
# NEXT_PUBLIC_ 접두사가 없으므로 서버에서만 읽힌다.
GEMSPOT_API_BASE_URL=

# 네이버 Geocoding 시크릿 키. 서버에서만 읽는다. 클라이언트 ID는 감출 수 없는
# 값이라 src/shared/naverMap.ts에 상수로 두었다 — 여기 없는 것이 맞다.
GEMSPOT_NAVER_API_KEY=

# TMAP 보행자 경로 API appKey(SK open API). 서버에서만 읽는다. 비우면 구간
# 도보 시간을 직선거리로 추정하고 화면에 "추정"으로 표시한다.
TMAP_APP_KEY=

# Gemini API 키. 서버에서만 읽는다. 비우면 동선 가이드가 문장을 해석하지 못해
# 기능이 비활성이다(구조화된 요청을 직접 주는 경로는 돈다).
GEMINI_API_KEY=
# 모델 이름. 비우면 src/lib/platform/env.ts의 기본값.
GEMINI_MODEL=
