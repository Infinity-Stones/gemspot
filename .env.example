# 필요한 키의 **목록**이다. 실제 값은 이 파일에 적지 않는다 —
# `.env.local`에 넣고, 그 파일은 .gitignore에 있다.
#
# 읽는 곳은 src/lib/platform/env.ts 한 곳이다. 비어 있으면 그 함수가 null을
# 돌려주고, 실패로 볼지는 부르는 쪽이 정한다 — 여기서 던지면 키 없이 화면을
# 띄워 보는 개발이 막힌다.

# 네이버 Geocoding 시크릿 키. 주소를 좌표로 바꾸는 데 쓴다 (M4 저장 · M7 출발점).
# 배포 프로젝트마다 등록된 이름이 다르다 — juhee200s-projects/gemspot에는
# GEMSPOT_NAVER_API_KEY, 다른 프로젝트에는 SECRET_KEY. env.ts가 둘을 차례로
# 읽으므로 로컬에는 하나만 채우면 된다.
# 짝이 되는 클라이언트 ID는 감출 수 없는 값이라 src/shared/naverMap.ts에 상수로
# 두었다 — 여기 없는 것이 맞다.
GEMSPOT_NAVER_API_KEY=
SECRET_KEY=

# TMAP 보행자 경로. 구간별 실제 거리·시간을 실측한다 (M7 · T40).
# 비우면 구간 도보 시간을 직선거리로 추정하고 화면에 "추정"으로 표시한다.
TMAP_APP_KEY=

# Gemini API 키 (D12 결정). 자연어 요청 해석과 순서·이유 제안에 쓴다 (M7 · T35 · T38).
# 비우면 문장 해석이 불가능해 기능이 비활성이다(구조화된 요청을 직접 주는 경로는 돈다).
GEMINI_API_KEY=
# 모델 이름. 비우면 src/lib/platform/env.ts의 기본값.
GEMINI_MODEL=

# Vercel AI Gateway. 게이트웨이를 지나면 제공자 교체가 모델 이름 문자열 하나로
# 끝난다. 아직 쓰는 코드가 없다 — Gemini 직접 호출 대신 이쪽으로 갈지는 D12에서 본다.
AI_GATEWAY_API_KEY=
