# 필요한 키의 **목록**이다. 실제 값은 이 파일에 적지 않는다 —
# `.env.local`에 넣고, 그 파일은 .gitignore에 있다.
#
# 읽는 곳은 src/lib/platform/env.ts 한 곳이다. 비어 있으면 그 함수가 null을
# 돌려주고, 실패로 볼지는 부르는 쪽이 정한다 — 여기서 던지면 키 없이 화면을
# 띄워 보는 개발이 막힌다.

# 네이버 Geocoding 시크릿 키. 주소를 좌표로 바꾸는 데 쓴다 (M4 저장 · M7 출발점).
# 배포 프로젝트(juhee200s-projects/gemspot)에 이 이름으로 등록되어 있다.
# 짝이 되는 클라이언트 ID는 감출 수 없는 값이라 src/shared/naverMap.ts에 상수로
# 두었다 — 여기 없는 것이 맞다.
GEMSPOT_NAVER_API_KEY=

# Supabase — 스팟 저장소 (D06). 둘 다 서버에서만 읽는다.
# URL은 대시보드 Project Settings → API의 Project URL. 키는 같은 화면의 secret 키
# (sb_secret_…). Vercel 마켓플레이스로 연동하면 SUPABASE_URL과
# SUPABASE_SERVICE_ROLE_KEY가 자동으로 들어오고, 코드는 그 이름도 읽는다.
# 비우면 스팟이 번들된 시드로 떨어지고 화면에 시드 배지가 뜬다.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# 네이버 검색 Local API — 가게 이름으로 업체를 찾는다 (M4 · T52).
# Maps와 다른 콘솔이다: developers.naver.com에서 애플리케이션을 등록하고 "검색"
# API를 선택하면 클라이언트 아이디·시크릿이 나온다. NCP의 Maps 키와 호환되지
# 않는다. 비우면 이름 검색만 비활성이고 주소 검색은 그대로 동작한다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# TMAP 보행자 경로. 구간별 실제 거리·시간을 실측한다 (M7 · T40).
# 비우면 구간 도보 시간을 직선거리로 추정하고 화면에 "추정"으로 표시한다.
TMAP_APP_KEY=

# Gemini API 키 (D12 결정). 자연어 요청 해석과 순서·이유 제안에 쓴다 (M7 · T35 · T38).
# 비우면 문장 해석이 불가능해 기능이 비활성이다(구조화된 요청을 직접 주는 경로는 돈다).
GEMINI_API_KEY=
# 모델 이름. 비우면 src/lib/platform/env.ts의 기본값.
GEMINI_MODEL=

# Vercel AI Gateway. 게이트웨이를 지나면 제공자 교체가 모델 이름 문자열 하나로
# 끝난다. 아직 쓰는 코드가 없다 — Gemini 직접 호출 대신 이쪽으로 갈지는 D12에서 본다.
AI_GATEWAY_API_KEY=
